# Copy to backend/.env and fill in. backend/.env is git-ignored — keep real keys there only.

ENVIRONMENT=dev
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
DATABASE_URL=sqlite:///./quik.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# mock works offline. Switch to duffel / paystack when you have keys.
FLIGHT_PROVIDER=mock
PAYMENT_PROVIDER=mock

DUFFEL_API_KEY=
DUFFEL_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=

# Revenue: Quik's fee on each booking
SERVICE_FEE_FLAT_NGN=3500
SERVICE_FEE_PERCENT=1.5
TRAIN_BOOKING_FEE_NGN=300
RESTAURANT_COMMISSION_PERCENT=10

PRICE_WATCH_INTERVAL_SECONDS=1800
PRICE_DROP_THRESHOLD_PERCENT=3

# Leave SMTP_HOST empty in dev: emails are written to backend/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Quik <tickets@yourdomain.com>

# Optional: smarter voice/chat understanding. Without it a rule-based parser runs.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
